@model MvcMovie.Models.Movie

@{
    ViewData["Title"] = "Edit";
}

<div class="page-header mb-4">
    <span class="page-kicker">UPDATE CATALOG</span>
    <h1 class="mb-1">Edit Movie</h1>
    <p class="text-muted mb-0">Update details for <strong>@Model?.Title</strong></p>
</div>

<div class="row">
    <div class="col-md-7 col-lg-6">
        <div class="content-card">
            <h4 class="card-section-title mb-3">Movie Information</h4>
            <hr class="ocean-divider mb-4" />
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group mb-3">
                    <label asp-for="Title" class="control-label form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-sm-6 form-group mb-3">
                        <label asp-for="ReleaseDate" class="control-label form-label fw-semibold"></label>
                        <input asp-for="ReleaseDate" class="form-control" />
                        <span asp-validation-for="ReleaseDate" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 form-group mb-3">
                        <label asp-for="Genre" class="control-label form-label fw-semibold"></label>
                        <input asp-for="Genre" class="form-control" />
                        <span asp-validation-for="Genre" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6 form-group mb-3">
                        <label asp-for="Price" class="control-label form-label fw-semibold"></label>
                        <input asp-for="Price" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 form-group mb-4">
                        <label asp-for="Rating" class="control-label form-label fw-semibold"></label>
                        <input asp-for="Rating" class="form-control" />
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-group d-flex align-items-center gap-3 pt-2">
                    <input type="submit" value="Save" class="btn btn-ocean px-4 fw-semibold" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
