@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "My Movies";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <span class="page-kicker">COLLECTION CATALOG</span>
        <h1 class="mb-1">My Movies</h1>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-turquoise fw-semibold px-4 shadow-sm">+ Create New</a>
    </div>
</div>

<div class="filter-bar mb-4">
    <form asp-controller="Movies" asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-sm-6 col-md-3">
            <label class="form-label fw-semibold text-ocean mb-1">Genre:
                <select asp-for="MovieGenre" asp-items="Model.Genres" class="form-select mt-1">
                    <option value="">All</option>
                </select>
            </label>
        </div>

        <div class="col-sm-6 col-md-3">
            <label class="form-label fw-semibold text-ocean mb-1">Year (or newer):
                <select asp-for="MovieYear" asp-items="Model.Years" class="form-select mt-1">
                    <option value="">All</option>
                </select>
            </label>
        </div>

        <div class="col-sm-8 col-md-4">
            <label class="form-label fw-semibold text-ocean mb-1 w-100">Title:
                <input type="text" asp-for="SearchString" class="form-control mt-1" placeholder="Search by movie title..." />
            </label>
        </div>

        <div class="col-sm-4 col-md-2 d-flex gap-2">
            <input type="submit" value="Filter" class="btn btn-ocean fw-semibold w-100" />
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset filters">Reset</a>
        </div>
    </form>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].Title)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].ReleaseDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].Genre)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].Price)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Movies![0].Rating)
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model.Movies!) {
                <tr>
                    <td class="fw-semibold text-ocean-dark">
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ReleaseDate)
                    </td>
                    <td>
                        <span class="badge-genre">@Html.DisplayFor(modelItem => item.Genre)</span>
                    </td>
                    <td class="fw-semibold text-teal-dark">
                        @Html.DisplayFor(modelItem => item.Price)
                    </td>
                    <td>
                        <span class="badge-rating">@Html.DisplayFor(modelItem => item.Rating)</span>
                    </td>
                    <td class="text-end action-links">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-edit">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-details">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-delete">Delete</a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>
